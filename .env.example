# ==============================================================================
# ROTA - Öğrenci Kariyer ve Rehberlik Platformu (.env.example)
# ==============================================================================
# Bu dosyayı projeyi klonlayan geliştiriciler `.env` olarak kopyalayarak
# kendi ortam değişkenlerini ayarlamalıdır:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# 1. VERİTABANI BAĞLANTISI (DATABASE_URL)
# Vercel Postgres / Neon veya Yerel PostgreSQL Bağlantı Adresi:
# Örnek PostgreSQL: DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=verify-full"
# Örnek Yerel SQLite (Eğer SQLite kullanıyorsanız): DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/rota_db"

# 2. NEXTAUTH AYARLARI
# Güvenlik için rastgele bir gizli anahtar (örn. openssl rand -base64 32)
NEXTAUTH_SECRET="gorsel-ve-gizli-bir-anahtar-yazin-2026"
NEXTAUTH_URL="http://localhost:3000"

# 3. YAPAY ZEKA (OPENAI-UYUMLU MODEL SERVİSİ)
# URL ve model zorunludur. Servis Bearer kimlik doğrulaması kullanıyorsa
# AI_API_KEY değerini yalnız sunucu tarafında tanımlayın; token gerekmiyorsa boş bırakın.
AI_API_URL="https://yz.gamehost.dev/v1/chat/completions"
AI_MODEL="qwen/qwen3.5-9b"
AI_API_KEY=""
# Üretimde tokensiz servise bilinçli olarak bağlanmak için true yapın.
AI_ALLOW_ANONYMOUS="false"
# Yerel model için toplam upstream bekleme bütçesi: 210 sn (3,5 dk).
# Güvenli aralık 30000–225000 ms; Next route sınırı 240 sn'dir.
AI_UPSTREAM_TIMEOUT_MS="210000"
# Model sunucusu strict JSON Schema destekliyorsa true yapın.
AI_JSON_SCHEMA_ENABLED="true"
# Yatırımcı demosunda açın; gerçek öğrenci pilotundan önce onay/saklama kapıları tamamlanmalıdır.
AI_FEATURE_ENABLED="false"
RIASEC_FEATURE_ENABLED="false"
DEVELOPMENT_ASSESSMENT_ENABLED="true"
